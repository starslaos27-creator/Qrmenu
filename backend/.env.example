NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Self-hosted PostgreSQL. URL-encode special characters in the password.
DATABASE_URL=postgresql://shopqr_app:CHANGE-ME@127.0.0.1:5432/shopqr
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate a private random value of at least 32 bytes. Never commit it.
AUTH_JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
# Optional one-time production admin setup token (at least 32 random bytes).
# Remove it from the server environment after creating the first admin.
ADMIN_BOOTSTRAP_TOKEN=
# Optional: restrict setup or recovery to this existing admin email.
ADMIN_BOOTSTRAP_EMAIL=
# Password recovery email (Resend). Required to send admin reset links.
RESEND_API_KEY=
MAIL_FROM=
ADMIN_PUBLIC_URL=http://localhost:5176
AUTH_ISSUER=shopqr
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false

# Optional: Google Cloud Translation Basic API key for translating all app pages.
# Keep this key private; translation requests are proxied by the backend.

# Temporary during the staged migration. Remove after Supabase cutover.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

IMAGE_STORAGE_DRIVER=r2
# Backend image uploads are stored in R2. Old local images remain readable
# through the compatibility endpoint until their database URLs are migrated.
R2_ACCOUNT_ID=YOUR-R2-ACCOUNT-ID
R2_ACCESS_KEY_ID=YOUR-R2-ACCESS-KEY-ID
R2_SECRET_ACCESS_KEY=YOUR-R2-SECRET-ACCESS-KEY
R2_BUCKET=YOUR-R2-BUCKET
R2_PUBLIC_BASE_URL=https://YOUR-PUBLIC-R2-DOMAIN
