{
  "name": "@shopqr/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node build/database/migrate.js",
    "setup:local": "node scripts/setup/setup-local.cjs",
    "data:add-categories": "node scripts/data/add-menu-categories.cjs",
    "data:add-appetizers": "node scripts/data/add-appetizer-menus.cjs",
    "data:sample-images": "node scripts/data/set-sample-menu-images.cjs",
    "data:share-details": "node scripts/data/share-menu-details.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.828.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@supabase/supabase-js": "^2.45.4",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.2.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
