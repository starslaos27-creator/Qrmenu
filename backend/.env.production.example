NODE_ENV=production
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=https://starsmenu.org,https://www.starsmenu.org,https://admin.starsmenu.org,https://api.starsmenu.org

# Replace with the production database and credentials.
DATABASE_URL=postgresql://shopqr_app:REPLACE_WITH_PASSWORD@127.0.0.1:5432/shopqr
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate a unique random secret of at least 32 bytes.
AUTH_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
# Temporary one-time setup/recovery values. Remove after bootstrap completes.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
# Password recovery email (Resend). Configure a verified sender domain.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MAIL_FROM=ShopQR <noreply@starsmenu.org>
ADMIN_PUBLIC_URL=https://admin.starsmenu.org
AUTH_ISSUER=shopqr
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true

# Google Cloud Translation Basic API key. Keep this secret on the backend only.

# Keep only if legacy Supabase sign-in migration is still needed.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

IMAGE_STORAGE_DRIVER=r2
R2_ACCOUNT_ID=YOUR-R2-ACCOUNT-ID
R2_ACCESS_KEY_ID=YOUR-R2-ACCESS-KEY-ID
R2_SECRET_ACCESS_KEY=YOUR-R2-SECRET-ACCESS-KEY
R2_BUCKET=YOUR-R2-BUCKET
R2_PUBLIC_BASE_URL=https://YOUR-PUBLIC-R2-DOMAIN
